PORT=5000
NODE_ENV=development

# Supabase project (service key stays on the server only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

ADMIN_USER=admin
ADMIN_PASS=choose-a-strong-password-at-least-12-characters
ADMIN_EMAIL=you@example.com

# Gmail app password, not your normal account password
MAIL_USER=
MAIL_PASS=

# WhatsApp OTP via Twilio (optional - falls back to console if not set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_WHATSAPP=8252336811

# OTP email fallback (sent to this address if WhatsApp fails)
ADMIN_OTP_EMAIL=deskamp33@gmail.com

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
